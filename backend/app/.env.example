# Mindrium 백엔드 환경 변수 예시
# 사용법: cp .env.example .env 후 실제 값을 채운다. (.env 는 git 에 올리지 않는다)
# Docker: docker run --env-file <이 형식의 파일> ...

##### 필수 #####
# 로컬: mongodb://127.0.0.1:27017
# Mac Docker 컨테이너에서 호스트 MongoDB: mongodb://host.docker.internal:27017
MONGO_URI=mongodb://127.0.0.1:27017
# 운영·데모·개발 DB 는 이름으로 분리한다. 예: mindrium_demo
DB_NAME=mindrium_dev
# 운영 값은 길고 무작위인 문자열로 바꾼다. 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

##### 상담 챗봇 (OpenAI) #####
# 없으면 상담 AI 호출이 실패하고 앱은 대체 응답(A 경로)으로 넘어간다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_BASE=https://api.openai.com/v1

##### 서버 #####
# Docker 이미지는 PORT(기본 8070)를 우선 사용한다.
API_PORT=8070
# 쉼표로 구분. 모바일 앱만 쓰면 기본값으로 충분하다.
CORS_ORIGINS=http://localhost:56000,http://127.0.0.1:56000,http://localhost:*

##### 토큰 만료 (선택, 기본값) #####
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
RESET_CODE_EXPIRE_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_RESEND_COOLDOWN_SECONDS=60

##### 이메일 발송 (선택: 비밀번호 재설정 코드) #####
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

##### 외부 플랫폼 연동 (선택) #####
PLATFORM_SIGNUP_URL=
PLATFORM_VERIFY_URL=
